rules_version = '2';

// Collection "products": mỗi document CHỈ có đúng 4 trường name, price, soluong, image.
// Chỉ tài khoản đã đăng nhập VÀ đã xác thực email mới được đọc/ghi.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && d.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && d.name is string && d.name.size() > 0
        && d.price is int && d.price >= 0
        && d.soluong is int && d.soluong >= 0
        && d.image is string && d.image.size() > 0;
    }

    match /products/{id} {
      allow read: if verified();
      allow create, update: if verified() && validProduct();
      allow delete: if verified();
    }
  }
}
